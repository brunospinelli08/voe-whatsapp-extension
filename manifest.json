{
  "manifest_version": 3,
  "name": "VOE — Atendimento WhatsApp",
  "description": "Painel de atendimento da VOE dentro do WhatsApp Web. Fallback para quando a conexão principal do módulo Conversas estiver indisponível.",
  "version": "0.1.0",

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "extension/background.js"
  },

  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app.voeops.com/*",
    "https://yjlogamiqdksvceiyfte.supabase.co/*"
  ],

  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],

  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["extension/content.js"],
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/index.html",
        "extension/wppconnect-wa.js",
        "extension/wa-js-bridge.js",
        "extension/wa-overrides.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
